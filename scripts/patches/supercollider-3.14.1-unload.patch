+    auto freeTable = [](auto*& table, auto freeItem) {
+        if (!table)
+            return;
+        for (int32 i = 0; i < table->TableSize(); ++i)
+            if (auto* item = table->AtIndex(i))
+                freeItem(item);
+        delete table;
+        table = nullptr;
+    };
