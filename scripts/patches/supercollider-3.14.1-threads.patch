SuperCollider 3.14.1: data races found by ThreadSanitizer in plugins/scsynth/tests, with two
Worlds in one process.

- MsgFifo publishes its heads with release stores but reads them relaxed, so the reader may use an
  item before it is written. x86 hides this; ARMv7 does not. The loads become acquires.
- SC_SyncCondition::write and SC_AudioDriver::mRunThreadFlag are plain variables shared between
  threads. They become atomics.
- gMissingNodeID, read only to word "Node %i not found", is one global written by every World's
  audio thread. It becomes thread_local.

--- a/common/MsgFifo.h
+++ b/common/MsgFifo.h
@@ -28,6 +28,7 @@
 
 namespace SCMsgFifo {
 
+using std::memory_order_acquire;
 using std::memory_order_relaxed;
 using std::memory_order_release;
 
@@ -41,12 +42,12 @@
         mFreeHead.store(writeHead, memory_order_release);
     }
     bool IsEmpty() { return mReadHead.load(memory_order_relaxed) == mWriteHead.load(memory_order_relaxed); }
-    bool HasData() { return mReadHead.load(memory_order_relaxed) != mWriteHead.load(memory_order_relaxed); }
-    bool NeedsFree() { return mFreeHead.load(memory_order_relaxed) != mReadHead.load(memory_order_relaxed); }
+    bool HasData() { return mReadHead.load(memory_order_relaxed) != mWriteHead.load(memory_order_acquire); }
+    bool NeedsFree() { return mFreeHead.load(memory_order_relaxed) != mReadHead.load(memory_order_acquire); }
 
     bool Write(MsgType& data) {
         unsigned int next = NextPos(mWriteHead.load(memory_order_relaxed));
-        if (next == mFreeHead.load(memory_order_relaxed))
+        if (next == mFreeHead.load(memory_order_acquire))
             return false; // fifo is full
         mItems[next] = data;
 
@@ -87,11 +88,11 @@
 
     void MakeEmpty() { mReadHead.store(mWriteHead.load()); }
     bool IsEmpty() { return mReadHead.load(memory_order_relaxed) == mWriteHead.load(memory_order_relaxed); }
-    bool HasData() { return mReadHead.load(memory_order_relaxed) != mWriteHead.load(memory_order_relaxed); }
+    bool HasData() { return mReadHead.load(memory_order_relaxed) != mWriteHead.load(memory_order_acquire); }
 
     bool Write(MsgType& data) {
         unsigned int next = NextPos(mWriteHead.load(memory_order_relaxed));
-        if (next == mReadHead.load(memory_order_relaxed))
+        if (next == mReadHead.load(memory_order_acquire))
             return false; // fifo is full
