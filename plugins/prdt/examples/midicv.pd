#N canvas 0 50 640 360 12;
#X text 20 10 MIDI to CV: 1 V/oct pitch on Out 1 \, with C4 at 0 V \, and a gate on Out 2. Any note off ends the note.;
#X obj 20 50 notein;
#X obj 20 100 stripnote;
#X obj 20 150 - 60;
#X obj 20 190 / 12;
#X obj 20 230 * 0.2;
#X obj 20 270 sig~;
#X obj 20 310 dac~ 1;
#X obj 220 100 > 0;
#X obj 220 270 sig~;
#X obj 220 310 dac~ 2;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 1 1 8 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
