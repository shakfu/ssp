#C 0 57;
#C 1 60;
#C 2 64;
#C 3 67;
#C 4 69;
#C 5 67;
#C 6 64;
#C 7 60;
#C flags 1 0;
#C restore;
#X obj 20 140 mtof;
#X obj 20 170 cycle~;
#X obj 20 200 onepole~ 2000;
#X obj 120 170 r cutoff;
