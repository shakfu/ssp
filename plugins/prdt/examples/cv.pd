#N canvas 0 50 640 400 12;
#X obj 20 20 adc~ 1;
#X obj 20 60 expr~ \$f2 * pow(2 \, \$v1 * 5);
#X obj 220 20 r base;
#X obj 20 100 osc~;
#X obj 20 140 *~ 0.5;
#X obj 20 180 dac~ 1;
#X text 300 100 Input 1 is pitch CV at one octave per volt (0.2 per volt) above base.;
#X text 300 180 @p1 base 20 2000 Hz log;
#X connect 0 0 1 0;
#X connect 2 0 1 1;
#X connect 1 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
