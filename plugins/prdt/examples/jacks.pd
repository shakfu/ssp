#N canvas 0 50 760 460 12;
#X text 20 10 One jack of each kind. Audio \, CV in \, CV out \, gate in and out \, trigger out.;
#X obj 20 60 adc~ 1;
#X obj 20 110 *~ 0;
#X obj 120 60 r gain;
#X obj 20 160 dac~ 1;
#X text 20 190 @p1 gain 0 1 cv 2;
#X obj 220 60 r volts;
#X obj 220 110 * 0.2;
#X obj 220 160 sig~;
#X obj 220 210 dac~ 2;
#X text 220 240 @p2 volts 0 5 V;
#X obj 420 60 adc~ 3;
#X obj 420 110 threshold~ 0.4 1 0.1 1;
#X msg 420 160 1;
#X msg 490 160 0;
#X obj 420 210 sig~;
#X obj 420 260 dac~ 3;
#X msg 590 160 1 \, 0 0 5;
#X obj 590 210 vline~;
#X obj 590 260 dac~ 4;
#X text 420 300 In 3 above 2 V opens the gate on Out 3 and fires a 5 ms trigger on Out 4.;
#X connect 1 0 2 0;
#X connect 3 0 2 1;
#X connect 2 0 4 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 12 0 13 0;
#X connect 12 0 17 0;
#X connect 12 1 14 0;
#X connect 11 0 12 0;
#X connect 13 0 15 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
