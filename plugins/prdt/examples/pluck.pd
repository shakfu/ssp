#N canvas 0 50 640 480 12;
#X obj 20 20 loadbang;
#X obj 20 50 metro 250;
#X obj 120 20 r rate;
#X obj 20 80 rand.i 0 4;
#X obj 20 110 tabread scale;
#X obj 20 140 + 48;
#X obj 20 170 pack f 100;
#X obj 20 200 pluck~ -midi 60 1000 6000;
#X obj 160 170 r decay;
#X obj 20 230 else/echo.rev~ 8 0.5;
#X obj 180 200 r size;
#X obj 20 260 *~ 0.3;
#X obj 20 290 dac~ 1 2;
#X obj 300 110 array define -k scale 5;
#A 0 0 2 4 7 9;
#X text 300 20 Random notes from a pentatonic scale \, plucked by ELSE's [pluck~] \, through ELSE's [echo.rev~] abstraction. [rand.i] picks a step of the scale \, which the array holds.;
#X text 300 260 @p1 rate 50 1000 ms log;
#X text 300 280 @p2 decay 100 5000 ms log;
#X text 300 300 @p3 size 0 1;
#X connect 0 0 1 0;
#X connect 2 0 1 1;
#X connect 1 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 8 0 7 2;
#X connect 7 0 9 0;
#X connect 10 0 9 1;
#X connect 9 0 11 0;
#X connect 11 0 12 0;
#X connect 11 0 12 1;
